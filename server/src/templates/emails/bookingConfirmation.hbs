<!-- Booking received (pending) — status amber (#F59E0B), DESIGN-SYSTEM §2.2 -->
<div style="font-family:Inter,Arial,sans-serif;max-width:560px;margin:0 auto;background:#ffffff;border:1px solid #E0F0F8;border-radius:12px;overflow:hidden">
  <div style="background:#0284C7;color:#ffffff;padding:20px 24px;font-size:18px;font-weight:600">RoomFlow</div>
  <div style="padding:24px">
    <h2 style="margin:0 0 8px;color:#0F172A;font-size:20px">Booking request received</h2>
    <p style="color:#64748B;margin:0 0 16px">Hi {{userName}}, your request is now <strong style="color:#F59E0B">pending approval</strong>.</p>
    <table style="width:100%;border-collapse:collapse;font-size:14px;color:#0F172A">
      <tr><td style="padding:6px 0;color:#64748B">Reference</td><td style="padding:6px 0;font-family:monospace">{{bookingRef}}</td></tr>
      <tr><td style="padding:6px 0;color:#64748B">Room</td><td style="padding:6px 0">{{roomName}} ({{roomCode}})</td></tr>
      <tr><td style="padding:6px 0;color:#64748B">Date</td><td style="padding:6px 0">{{date}}</td></tr>
      <tr><td style="padding:6px 0;color:#64748B">Time</td><td style="padding:6px 0">{{startTime}}–{{endTime}}</td></tr>
      <tr><td style="padding:6px 0;color:#64748B">Purpose</td><td style="padding:6px 0">{{purpose}}</td></tr>
    </table>
    <p style="color:#64748B;font-size:13px;margin:16px 0 0">You will be notified once an approver reviews your request.</p>
  </div>
  <div style="padding:16px 24px;background:#EFF7FB;color:#64748B;font-size:12px">RoomFlow — Smart Room Booking</div>
</div>
