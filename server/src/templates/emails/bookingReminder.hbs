<!-- Upcoming booking reminder — primary (#0284C7) -->
<div style="font-family:Inter,Arial,sans-serif;max-width:560px;margin:0 auto;background:#ffffff;border:1px solid #E0F0F8;border-radius:12px;overflow:hidden">
  <div style="background:#0284C7;color:#ffffff;padding:20px 24px;font-size:18px;font-weight:600">Upcoming Booking Reminder</div>
  <div style="padding:24px">
    <p style="color:#0F172A;margin:0 0 16px">Hi {{userName}}, this is a reminder for your booking <strong>{{bookingRef}}</strong> starting soon.</p>
    <table style="width:100%;border-collapse:collapse;font-size:14px;color:#0F172A">
      <tr><td style="padding:6px 0;color:#64748B">Room</td><td style="padding:6px 0">{{roomName}} ({{roomCode}})</td></tr>
      <tr><td style="padding:6px 0;color:#64748B">Date</td><td style="padding:6px 0">{{date}}</td></tr>
      <tr><td style="padding:6px 0;color:#64748B">Time</td><td style="padding:6px 0">{{startTime}}–{{endTime}}</td></tr>
    </table>
  </div>
  <div style="padding:16px 24px;background:#EFF7FB;color:#64748B;font-size:12px">RoomFlow — Smart Room Booking</div>
</div>
