# =============================================================================
# RoomFlow Backend — Environment Variables (TEMPLATE)
# Copy to `.env` and fill real values. NEVER commit the real `.env`.
# config/env.js validates every one of these at boot and exits if invalid.
# =============================================================================

# --- Core ---
NODE_ENV=development
PORT=5000
API_VERSION=v1

# --- Client / CORS (comma-separated allowlist) ---
CLIENT_URL=http://localhost:5173

# --- Database ---
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/roomflow?retryWrites=true&w=majority

# --- JWT (reserved for Phase 1 — different secrets, generate 64-byte hex) ---
JWT_ACCESS_SECRET=change_me_access_64_byte_hex
JWT_REFRESH_SECRET=change_me_refresh_64_byte_hex
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Security ---
BCRYPT_ROUNDS=12

# --- Auth (Phase 1B) ---
REFRESH_TOKEN_TTL_DAYS=7
MAX_LOGIN_ATTEMPTS=10
ACCOUNT_LOCK_MINUTES=15
RESET_TOKEN_EXPIRY_MIN=15
EMAIL_VERIFICATION_EXPIRY_HOURS=24

# --- Cloudinary (file upload) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=roomflow_dev

# --- Email (Nodemailer / SMTP; use Mailtrap in development) ---
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM_NAME=RoomFlow
MAIL_FROM_EMAIL=no-reply@roomflow.app

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- Scheduled-job trigger secret (reserved for later phases) ---
JOB_TRIGGER_SECRET=change_me_random

# --- Logging ---
LOG_LEVEL=debug
